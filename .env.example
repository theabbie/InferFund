# InferFund environment configuration.
# Copy to .env for local development: cp .env.example .env
# NEVER commit a real .env file.

# --- Required public configuration ---
# Public origin of this InferFund deployment (no trailing slash).
INFERFUND_BASE_URL=http://localhost:3000
# Canonical MCP resource URL (RFC 8707 resource identifier).
INFERFUND_MCP_RESOURCE_URL=http://localhost:3000/api/mcp

# NO DATABASE: InferFund is fully stateless. All durable state lives in Git
# (the progress branch) and GitHub metadata; OAuth state is carried in signed
# tokens. There is no DATABASE_URL.

# --- InferFund auth/session security ---
# Generate with: openssl rand -base64 48
INFERFUND_SESSION_SECRET=change-me-min-32-chars-aaaaaaaaaaaaaaaaaaaa
INFERFUND_TOKEN_SECRET=change-me-min-32-chars-bbbbbbbbbbbbbbbbbbbb

# --- GitHub user authentication ---
# EITHER a classic OAuth App (https://github.com/settings/developers,
# callback ${INFERFUND_BASE_URL}/auth/github/callback):
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# OR (recommended) the GitHub App's own client credentials, set by
# `npm run setup:github-app` — one registration covers login AND writes.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# --- GitHub repository that hosts main + progress branches ---
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# --- GitHub App (service identity; performs all repository mutation) ---
# Easiest: `npm run setup:github-app` creates + installs it and fills these in.
# Permissions: Contents RW, Pull requests RW, Checks RW, Issues RW, Metadata R;
# events: pull_request. On Vercel, paste the PEM with literal \n escapes.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Used for webhook signature verification on /api/github/webhook:
GITHUB_APP_WEBHOOK_SECRET=

# --- Admins: comma-separated immutable numeric GitHub user IDs ---
INFERFUND_ADMIN_GITHUB_IDS=

# --- Optional runtime limits (defaults shown) ---
# INFERFUND_MAX_OPEN_ATTEMPTS=3
# INFERFUND_MAX_ATTEMPTS_PER_DAY=5
# INFERFUND_MAX_SUBMISSIONS_PER_DAY=10
# INFERFUND_MAX_LEAN_SUBMISSIONS_PER_DAY=5
# INFERFUND_MAX_ATTEMPT_BYTES=1048576
# INFERFUND_MAX_FILES_PER_ATTEMPT=20

# --- Optional GitHub configuration (defaults match the spec) ---
# INFERFUND_PROGRESS_BRANCH=progress
# INFERFUND_ATTEMPT_BRANCH_PREFIX=attempt

# --- Preview safety ---
# Writes are enabled automatically only in production. To enable GitHub
# mutations in a non-production environment (e.g. a dev deployment with its
# OWN sandbox repo), set:
# INFERFUND_ENABLE_WRITES=true

# --- Formal Conjectures override ---
# The canonical pin lives in config/formal-conjectures.json. Only override at
# runtime for testing:
# FORMAL_CONJECTURES_REF=

# --- Development-only PAT fallback (NEVER use in production) ---
# A PAT with repo access to a PERSONAL SANDBOX repository. Only used when the
# GitHub App variables above are unset and NODE_ENV != production.
# GITHUB_DEV_ADMIN_TOKEN=

# --- Vercel automation (CLI/CI only; the app runtime does not use this) ---
# VERCEL_TOKEN=
